{
  "name": "@mina-rust/shared",
  "version": "0.126.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "deploy": "npm run pack && npm run publish && npm run update",
    "pack": "ng-packagr -p ng-package.json && cd ../../dist/mina-rust-shared && npm pack",
    "publish": "cd ../../dist/mina-rust-shared && npm publish --access public",
    "update": "cd ../../ && npm i @mina-rust/shared@latest && cd ../mina/frontend && npm i @mina-rust/shared@latest"
  },
  "peerDependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.1.0",
    "@ngneat/until-destroy": ">=10.0.0",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "d3": ">=7.8.4",
    "ngx-json-viewer": ">=3.2.1",
    "rxjs": ">=7.8.0",
    "zone.js": ">=0.14.0"
  },
  "dependencies": {
    "tslib": ">=2.3.0"
  },
  "sideEffects": false,
